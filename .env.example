# ── Local paths ──────────────────────────────────────────────────────────────
SAFETY_TWIN_CONFIG=config/defaults.yaml
SAFETY_TWIN_ARTIFACT_DIR=artifacts
SAFETY_TWIN_CACHE_DIR=data/cache
SAFETY_TWIN_OUTPUT_DIR=output

# ── Gemini (Google AI Studio) ─────────────────────────────────────────────────
# Get from: https://aistudio.google.com → Get API key
# Leave unset to use deterministic fallback (no Gemini call).
# GEMINI_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: supabase.com → your project → Settings → API
# SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_BUCKET=run-media

# ── Hugging Face ──────────────────────────────────────────────────────────────
# Get from: huggingface.co → Settings → Access Tokens → New token (Write)
# HF_TOKEN=hf_...
# HF_SPACE=your-username/safety-twin

# ── Langfuse (optional LLMOps tracing) ───────────────────────────────────────
# Get from: cloud.langfuse.com → free tier, no card
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
