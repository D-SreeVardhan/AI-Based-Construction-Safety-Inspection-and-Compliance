# Copy to .env for local use; never commit .env. In the cloud these are secrets/variables
# set on the service (docs/deploy/cloud.md), not files.

# ---- offline pipeline
# Optional. Scene bootstrap falls back to cache / local heuristics when unset.
# GEMINI_API_KEY=
SAFETY_TWIN_CONFIG=config/defaults.yaml
SAFETY_TWIN_ARTIFACT_DIR=artifacts
SAFETY_TWIN_CACHE_DIR=data/cache
SAFETY_TWIN_OUTPUT_DIR=output

# ---- hosted demo (app/cloud.py)
# Where published bundles are; and/or a Hugging Face dataset to fetch them from.
# SAFETY_RUNS_DIR=output
# SAFETY_RUNS_REPO=<hf-user>/safety-twin-runs
# HF_TOKEN=                      # secret; only for a private dataset or for publishing

# Chatbot model: gemini | groq | openrouter | hf | anthropic | ollama | custom | none
# SAFETY_LLM_PROVIDER=ollama
# SAFETY_LLM_API_KEY=            # secret
# SAFETY_LLM_MODEL=              # optional override of the provider's default
# SAFETY_LLM_BASE_URL=           # required for custom
# SAFETY_LLM_REASONING=none      # optional reasoning_effort for thinking models
# SAFETY_CHAT_PER_MINUTE=8

# Optional managed database for chat logs and incident reviews (docs/deploy/supabase.sql).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_SERVICE_KEY=          # secret; server side only, never in the browser
